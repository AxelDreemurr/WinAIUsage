{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "Container",
      "$when": "${$host.widgetSize == \"small\"}",
      "selectAction": { "type": "Action.Execute", "verb": "open" },
      "items": [
        {
          "type": "TextBlock",
          "$when": "${!hasRows}",
          "text": "${empty}",
          "size": "Small",
          "isSubtle": true,
          "wrap": true
        },
        {
          "type": "ColumnSet",
          "$data": "${rows}",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${name}", "size": "Small", "weight": "Bolder" }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${pct}", "size": "Small", "weight": "Bolder", "color": "${color}" }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "$when": "${$host.widgetSize != \"small\"}",
      "items": [
        {
          "type": "TextBlock",
          "$when": "${!hasRows}",
          "text": "${empty}",
          "isSubtle": true,
          "wrap": true
        },
        {
          "type": "Container",
          "$data": "${rows}",
          "spacing": "Medium",
          "items": [
            {
              "type": "ColumnSet",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "verticalContentAlignment": "Bottom",
                  "items": [
                    { "type": "TextBlock", "text": "${name}", "weight": "Bolder" }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "verticalContentAlignment": "Bottom",
                  "items": [
                    { "type": "TextBlock", "text": "${pct}", "weight": "Bolder", "color": "${color}" }
                  ]
                }
              ]
            },
            {
              "type": "ColumnSet",
              "spacing": "Small",
              "columns": [
                { "type": "Column", "width": "${used}", "style": "${barStyle}", "minHeight": "4px", "items": [] },
                { "type": "Column", "width": "${rest}", "style": "emphasis", "minHeight": "4px", "spacing": "None", "items": [] }
              ]
            },
            {
              "type": "TextBlock",
              "text": "${detail}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "Small",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "$when": "${cost != ''}",
              "text": "${cost}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "None"
            }
          ]
        },
        {
          "type": "ColumnSet",
          "spacing": "Medium",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${updated}", "size": "Small", "isSubtle": true }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "ActionSet",
                  "actions": [
                    { "type": "Action.Execute", "title": "${refresh}", "verb": "refresh" },
                    { "type": "Action.Execute", "title": "${open}", "verb": "open" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
