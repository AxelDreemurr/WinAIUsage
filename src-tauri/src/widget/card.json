{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "selectAction": { "type": "Action.Execute", "verb": "open" },
  "body": [
    {
      "type": "TextBlock",
      "$when": "${!hasRows}",
      "text": "${empty}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true
    },
    {
      "type": "ColumnSet",
      "$data": "${rows}",
      "spacing": "${gap}",
      "columns": [
        {
          "type": "Column",
          "width": "16px",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "Image",
              "$when": "${icon != '' && $host.hostTheme == \"light\"}",
              "url": "${iconOnLight}",
              "width": "16px",
              "height": "16px",
              "altText": "${name}"
            },
            {
              "type": "Image",
              "$when": "${icon != '' && $host.hostTheme != \"light\"}",
              "url": "${icon}",
              "width": "16px",
              "height": "16px",
              "altText": "${name}"
            }
          ]
        },
        {
          "type": "Column",
          "width": 28,
          "spacing": "Small",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${name}", "size": "Small", "weight": "Bolder", "maxLines": 1 }
          ]
        },
        {
          "type": "Column",
          "width": 16,
          "spacing": "Small",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${label}", "size": "Small", "isSubtle": true, "maxLines": 1 }
          ]
        },
        {
          "type": "Column",
          "width": 38,
          "spacing": "Small",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "Image", "url": "${bar}", "size": "Stretch", "altText": "${pct}" }
          ]
        },
        {
          "type": "Column",
          "width": 18,
          "spacing": "Small",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${pct}", "size": "Small", "weight": "Bolder", "color": "${color}", "horizontalAlignment": "Right", "maxLines": 1 }
          ]
        },
        {
          "type": "Column",
          "$when": "${$host.widgetSize != \"small\"}",
          "width": 24,
          "spacing": "Small",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${reset}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Right", "maxLines": 1 }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${$host.widgetSize != \"small\" && costs != ''}",
      "text": "${costs}",
      "size": "Small",
      "isSubtle": true,
      "wrap": true,
      "spacing": "Medium"
    },
    {
      "type": "ColumnSet",
      "$when": "${$host.widgetSize != \"small\"}",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${updated}", "size": "Small", "isSubtle": true }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "ActionSet",
              "actions": [
                { "type": "Action.Execute", "title": "${refresh}", "verb": "refresh" },
                { "type": "Action.Execute", "title": "${open}", "verb": "open" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
